# ===========================================================================
# 环境变量示例 —— 复制为 .env 后按需填写
#
#   cp .env.example .env
#
# 说明：
#   - 所有变量都是可选的，留空走代码内默认值或对应功能关闭。
#   - 第三方 API key 也可以在 Web UI「全局配置」里配置，二选一即可。
#   - 切勿把填好真实值的 .env 提交进 git（已在 .gitignore 忽略）。
# ===========================================================================

# ----- 主服务 -------------------------------------------------------------
# 面板访问密码（可选启动引导）：
# - 留空：首次打开 Web 会进入「初始化访问密码」页面，在页面上设置密码。
# - 填写：作为启动时明文管理密码（类似 CLIProxyAPI MANAGEMENT_PASSWORD），
#   不写入数据库；登录后下发会话 token，不再直接用密码当 token。
# 也可使用同义变量 MANAGEMENT_PASSWORD。
APP_PASSWORD=
# MANAGEMENT_PASSWORD=
# 数据库连接串。默认使用项目根目录下的 account_manager.db。
# Docker 持久化示例：sqlite:////app/data/account_manager.db
ACCOUNT_MANAGER_DATABASE_URL=

# ----- Docker / noVNC ------------------------------------------------------
# headed 浏览器模式下 noVNC 的访问密码。留空 = 无密码。
VNC_PASSWORD=

# ----- 本地 Turnstile Solver ----------------------------------------------
# 本地 Camoufox solver 监听端口（默认 5073，容器内对外暴露 8889）。
SOLVER_PORT=

# ----- Camoufox browser runtime -------------------------------------------
# Linux 无头模式：virtual（默认，每个 worker 独立 Xvfb）、native 或 display。
# Windows 始终使用 Camoufox 原生 headless；有头模式使用当前桌面/DISPLAY。
CAMOUFOX_LINUX_HEADLESS=virtual
# 失败证据目录。留空时写入 data/registration-artifacts。
REGISTRATION_ARTIFACT_DIR=

# ----- Registration capacity ----------------------------------------------
# 三种模式分别限流；实际并发还会受到代理、邮箱、验证码和可用内存限制。
REGISTER_PROTOCOL_MAX=20
# 用户未填写并发时始终从 1 开始。直连出口在连续健康结果后可逐步升至
# REGISTER_DIRECT_EGRESS_MAX；协议、无头和有头共享同一出口门槛。
REGISTER_DIRECT_EGRESS_MAX=3
REGISTER_PROTOCOL_DIRECT_MAX=20
REGISTER_HEADLESS_MAX=4
REGISTER_HEADLESS_DIRECT_MAX=4
REGISTER_HEADED_MAX=2
REGISTER_HEADED_DIRECT_MAX=3
# 浏览器 worker 内存预算（MiB）与系统预留。
REGISTER_HEADLESS_WORKER_MB=900
REGISTER_HEADED_WORKER_MB=1100
REGISTER_MEMORY_RESERVE_MB=768

# ----- Captcha provider capacity ------------------------------------------
CAPTCHA_LOCAL_SOLVER_MAX=1
CAPTCHA_YESCAPTCHA_API_MAX=5
CAPTCHA_TWOCAPTCHA_API_MAX=5
